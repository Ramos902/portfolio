---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import HeaderBlog from "../../components/HeaderBlog.astro";

type Post = CollectionEntry<"blog">;

const posts = (await getCollection("blog")).sort(
    (a: Post, b: Post) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const groups: Record<string, Post[]> = {};
for (const post of posts) {
    const label = post.data.date.toLocaleDateString("pt-BR", {
        year: "numeric",
        month: "long",
    });
    if (!groups[label]) groups[label] = [];
    groups[label].push(post);
}
---

<Layout title="Blog">
    <HeaderBlog />

    <main class="blog-main">
        <header class="blog-hero">
            <h1 class="blog-title">Ramos<span class="accent">.blog</span></h1>
            <p class="blog-subtitle">
                Bem-vindo ao meu blog! aqui você vai encontrar anotações sobre o
                que estudo, construo e aprendo - Programação, infraestrutura,
                cyber e às vezes coisas aleatórias.
            </p>
        </header>

        <div class="blog-list" id="blog-list">
            {
                Object.entries(groups).map(([label, groupPosts]) => (
                    <section class="month-group">
                        <h2 class="month-label">{label}</h2>
                        <ul class="post-list">
                            {groupPosts.map((post: Post) => (
                                <li
                                    class="post-item"
                                    data-title={post.data.title.toLowerCase()}
                                    data-body={post.body?.toLowerCase() ?? ""}
                                >
                                    <a
                                        href={`/blog/${post.id}`}
                                        class="post-link"
                                    >
                                        <div class="post-header-row">
                                            <span class="post-id">
                                                POST #
                                                {String(
                                                    post.data.postId,
                                                ).padStart(3, "0")}
                                            </span>
                                            <span class="post-arrow">→</span>
                                        </div>
                                        <div class="post-info">
                                            <span class="post-title">
                                                {post.data.title}
                                            </span>
                                            <span class="post-desc">
                                                {post.data.description}
                                            </span>
                                        </div>
                                        <span class="post-tags">
                                            {post.data.tags?.map(
                                                (tag: string) => (
                                                    <span class="tag">
                                                        #{tag}
                                                    </span>
                                                ),
                                            )}
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </div>

        <p class="no-results" id="no-results" style="display:none">
            Nenhum post encontrado.
        </p>
    </main>
</Layout>

<script>
    const input = document.getElementById("blog-search") as HTMLInputElement;
    const noResults = document.getElementById("no-results") as HTMLElement;

    input?.addEventListener("input", () => {
        const query = input.value.toLowerCase().trim();
        const items = document.querySelectorAll<HTMLElement>(".post-item");
        const groups = document.querySelectorAll<HTMLElement>(".month-group");

        items.forEach((item) => {
            const title = item.dataset.title ?? "";
            const body = item.dataset.body ?? "";
            item.style.display =
                !query || title.includes(query) || body.includes(query)
                    ? ""
                    : "none";
        });

        groups.forEach((group) => {
            const hasVisible = [
                ...group.querySelectorAll<HTMLElement>(".post-item"),
            ].some((i) => i.style.display !== "none");
            group.style.display = hasVisible ? "" : "none";
        });

        const anyVisible = [...items].some((i) => i.style.display !== "none");
        noResults.style.display = anyVisible ? "none" : "block";
    });
</script>

<style>
    .blog-main {
        max-width: 800px;
        margin: 0 auto;
        padding: 120px 1.5rem 5rem;
    }

    /* ─── Hero / cabeçalho ─────────────────────────────────────── */

    .blog-hero {
        margin-bottom: 4rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--border);
    }

    .blog-title {
        font-family: "Georgia", serif;
        font-size: clamp(2.2rem, 5vw, 3.2rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
        line-height: 1.1;
    }

    .accent {
        color: var(--accent);
    }

    .blog-subtitle {
        font-family: monospace;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        color: var(--text-muted);
        line-height: 1.6;
    }

    /* ─── Lista de posts ───────────────────────────────────────── */

    .blog-list {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    /* ─── Grupo por mês ────────────────────────────────────────── */

    .month-label {
        font-family: monospace;
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1.25rem;
        padding-bottom: 0;
        border-bottom: none;

        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    /* linha decorativa que se estende após o label do mês */
    .month-label::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(
            to right,
            color-mix(in srgb, var(--accent) 30%, transparent),
            transparent
        );
    }

    /* ─── Sem resultados ───────────────────────────────────────── */

    .no-results {
        font-family: monospace;
        font-size: 0.85rem;
        color: var(--text-muted);
        text-align: center;
        padding: 3rem 0;
    }

    /* ─── Lista de posts (ul) ──────────────────────────────────── */

    :global(.post-list) {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.65rem; /* espaço entre cards */
    }

    /* ─── Card individual ──────────────────────────────────────── */

    /* ─── Light mode overrides para os cards ──────────────────── */

    :global(.post-item) {
        position: relative;
        border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        border-left: 3px solid var(--accent);
        border-radius: 4px;
        overflow: hidden;
        transition:
            transform 0.15s ease,
            border-left-color 0.15s ease,
            background 0.15s ease;
    }

    /* textura scanline sutil */
    :global(.post-item::before) {
        content: "";
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            0deg,
            transparent,
            transparent 2px,
            rgba(255, 255, 255, 0.012) 2px,
            rgba(255, 255, 255, 0.012) 4px
        );
        pointer-events: none;
        z-index: 0;
    }

    /* linha de luz no topo que aparece no hover */
    :global(.post-item::after) {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            to right,
            color-mix(in srgb, var(--accent) 50%, transparent),
            transparent
        );
        opacity: 0;
        transition: opacity 0.15s ease;
        z-index: 1;
    }

    :global(.post-item:hover) {
        transform: translateX(4px);
        border-left-color: color-mix(in srgb, var(--accent) 150%, #fff);
        background: color-mix(in srgb, var(--border) 15%, transparent);
    }

    :global(.post-item:hover::after) {
        opacity: 1;
    }

    /* ─── Link wrapper ─────────────────────────────────────────── */

    :global(.post-link) {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 0;
        padding: 1rem 1.25rem 0.9rem 1.35rem;
        color: var(--text-primary);
        text-decoration: none;
    }

    /* ─── Linha superior: número do post + seta ────────────────── */

    :global(.post-header-row) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.3rem;
    }

    /* Número do post — ex: POST #005 */
    :global(.post-id) {
        font-family: monospace;
        font-size: 0.62rem;
        letter-spacing: 0.14em;
        color: var(--accent);
        opacity: 0.8;
        text-transform: uppercase;
        transition: opacity 0.15s;
    }

    :global(.post-item:hover .post-id) {
        opacity: 1;
    }

    /* seta → no canto direito */
    :global(.post-arrow) {
        font-family: monospace;
        font-size: 0.75rem;
        color: color-mix(in srgb, var(--text-muted) 50%, transparent);
        transition:
            color 0.15s ease,
            transform 0.15s ease;
        flex-shrink: 0;
    }

    :global(.post-item:hover .post-arrow) {
        color: var(--accent);
        transform: translateX(3px);
    }

    /* ─── Área de texto ────────────────────────────────────────── */

    :global(.post-info) {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    /* título com Playfair para contrastar com o monospace */
    :global(.post-title) {
        font-family: "Playfair Display", "Georgia", serif;
        font-size: 0.97rem;
        font-weight: 400;
        line-height: 1.35;
        color: var(--text-primary);
        transition: color 0.15s ease;
    }

    :global(.post-item:hover .post-title) {
        color: color-mix(in srgb, var(--text-primary) 85%, var(--accent));
    }

    /* descrição */
    :global(.post-desc) {
        font-family: monospace;
        font-size: 0.72rem;
        color: var(--text-muted);
        line-height: 1.55;
        font-weight: 400;
        transition: color 0.15s ease;
    }

    :global(.post-item:hover .post-desc) {
        color: color-mix(in srgb, var(--text-muted) 80%, var(--accent));
    }

    /* ─── Tags ─────────────────────────────────────────────────── */

    :global(.post-tags) {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        margin-top: 0.7rem;
    }

    :global(.tag) {
        font-family: monospace;
        font-size: 0.62rem;
        letter-spacing: 0.06em;
        color: color-mix(in srgb, var(--text-muted) 70%, transparent);
        background: color-mix(in srgb, var(--border) 30%, transparent);
        border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        border-radius: 2px;
        padding: 2px 7px;
        transition:
            color 0.15s ease,
            border-color 0.15s ease;
    }

    :global(.post-item:hover .tag) {
        color: color-mix(in srgb, var(--accent) 80%, transparent);
        border-color: color-mix(in srgb, var(--accent) 25%, transparent);
    }

    /* ─── Responsividade ───────────────────────────────────────── */

    @media (max-width: 600px) {
        :global(.post-tags) {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .blog-main {
            padding-top: 130px;
        }
    }
</style>
